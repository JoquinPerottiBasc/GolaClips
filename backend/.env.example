# Copy to .env and fill in values.

GEMINI_API_KEY=

# Firebase Admin (JSON string of the service account, single line)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public URL of the app (used for Stripe success/cancel redirects)
APP_URL=http://127.0.0.1:8000

# Stripe — required for Pro subscription checkout
# Create a Product + recurring Price ($12/mes) in Stripe Dashboard, then paste the Price ID (price_...)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# Webhook signing secret for POST /api/stripe/webhook (production)
STRIPE_WEBHOOK_SECRET=

# production | development — in production, dev Pro bypass is always off
ENVIRONMENT=development

# Local only: activate Pro without Stripe (never set to 1 in production)
GOLACLIPS_DEV_PRO_UPGRADE=0
